# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Admin IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# Intercom API Configuration
INTERCOM_ENDPOINT=https://api.boon.systems:8081/api/intercoms/86827066-d87d-47d2-bac1-4063d29d5ed6/openDoor
PARKING_ENDPOINT=https://elevators-api.boon.systems/api/parking/open/71d75d6c-71a0-4995-8c6d-dfaac1846d56
INTERCOM_TOKEN=your_intercom_bearer_token_here
PREVIEW_URL=https://example.com/camera.jpg

# Database Configuration
DATABASE_URL=postgresql://intercom_user:intercom_password@postgres:5432/intercom_db


# Optional proxy for Telegram API (socks5://user:pass@host:1080 or http://host:3128)
# TELEGRAM_PROXY=

# Optional failover to a local telegram-bot-api server (used when api.telegram.org hangs)
# TELEGRAM_LOCAL_API_URL=http://telegram-bot-api:8081
# api_id / api_hash from https://my.telegram.org (for the telegram-bot-api service)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# Timezone offset for times shown to users (hours from UTC)
# TZ_OFFSET_HOURS=4
